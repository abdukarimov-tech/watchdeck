<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="@drawable/widget_background">
    <TextView android:id="@+id/widget_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#E6EAF2" android:textSize="18sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/widget_state" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#9AA4B5" android:textSize="12sp" android:maxLines="2" />
    <TextView android:id="@+id/widget_metrics" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#6B9EFF" android:textSize="16sp" android:layout_marginTop="8dp" />
    <TextView android:id="@+id/widget_incident" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:textColor="#EF7C82" android:textSize="12sp" android:maxLines="2" android:ellipsize="end" />
    <TextView android:id="@+id/widget_updated" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#9AA4B5" android:textSize="11sp" />
</LinearLayout>
