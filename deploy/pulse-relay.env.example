# /etc/pulse-relay/pulse-relay.env — конфиг релея (chmod 600)
# адрес и порт HTTP-сервера (за reverse-proxy; напрямую наружу не выставлять)
PULSE_BIND=127.0.0.1:8080
# токен админских операций (/api/tokens, список агентов) — сгенерируйте: openssl rand -hex 24
PULSE_ADMIN_TOKEN=change-me
# путь к БД (systemd StateDirectory кладет в /var/lib/pulse-relay)
PULSE_DB=/var/lib/pulse-relay/relay.db

# --- FCM push (опционально) ---
# PULSE_FCM_PROJECT_ID=your-firebase-project
# GOOGLE_APPLICATION_CREDENTIALS=/etc/pulse-relay/firebase-service-account.json
