<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>servers_count</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@servers@</string>
		<key>servers</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d server</string>
			<key>other</key>
			<string>%d servers</string>
		</dict>
	</dict>
	<key>agents_count</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@agents@</string>
		<key>agents</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d agent</string>
			<key>other</key>
			<string>%d agents</string>
		</dict>
	</dict>
	<key>cpu_cores</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@cores@</string>
		<key>cores</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d core</string>
			<key>other</key>
			<string>%d cores</string>
		</dict>
	</dict>
</dict>
</plist>
